<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>HorseStrap</RootNamespace>
    </PropertyGroup>

    <!--
        No PackageReference entries. No npm. Nothing to restore but the SDK itself.
        The ASP.NET Core framework reference is implicit for Microsoft.NET.Sdk.Web.
    -->

    <ItemGroup>
        <!-- Static site generator output. Never compile or publish it. -->
        <Content Remove="static/**" />
        <None Remove="static/**" />
    </ItemGroup>

</Project>
