@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />

    <link rel="icon" href="~/favicon.ico" />

    @*
        One stylesheet. main.css pulls in everything else via @@import.
        asp-append-version busts the cache on change.
    *@
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />

    @* FontAwesome 7 (self-hosted, woff2 only). Drop this line if unused. *@
    <link rel="stylesheet" href="~/lib/fontawesome/fontawesome.min.css" asp-append-version="true" />

    @*
        Alpine must be deferred and must load BEFORE main.js runs its
        alpine:init handler. `defer` on both preserves document order.
    *@
    <script defer src="~/js/main.js" type="module" asp-append-version="true"></script>
    <script defer src="~/lib/alpine/alpine.min.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Head", required: false)
</head>
<body data-env="@Env.EnvironmentName">

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
