@page
@model BuildModel
@{
    ViewData["Title"] = "Build static site";
}

<main class="page-build">
    <div class="container prose stack">

        <h1>Build static site</h1>

        <p class="text-muted">
            Crawls every Razor page over HTTP and writes the rendered HTML to
            disk, alongside a copy of <code>wwwroot</code>. The result is a
            plain folder of files you can host anywhere.
        </p>

        @if (Model.Message is not null)
        {
            <p><strong>@Model.Message</strong></p>
        }

        @if (Model.Results.Count > 0)
        {
            <ul role="list" class="build-results stack" style="--stack-space: var(--space-3xs);">
                @foreach (var result in Model.Results)
                {
                    <li class="@(result.Success ? "build-ok" : "build-fail")">
                        @(result.Success ? "✓" : "✗") @result.Page — @result.Message
                    </li>
                }
            </ul>
        }

        <form method="post" class="stack">

            <div class="build-field">
                <label asp-for="BaseUrl">Site URL</label>
                <input asp-for="BaseUrl" type="text" />
            </div>

            <div class="build-field">
                <label asp-for="OutputPath">Output folder</label>
                <input asp-for="OutputPath" type="text" />
            </div>

            <div class="build-field">
                <label asp-for="WebRoot">wwwroot folder</label>
                <input asp-for="WebRoot" type="text" />
            </div>

            <div class="build-field">
                <label asp-for="Exclusions">Exclude paths containing</label>
                <input asp-for="Exclusions" type="text" />
            </div>

            <div class="cluster">
                <button type="submit" class="button">
                    <i class="fa-solid fa-hammer" aria-hidden="true"></i>
                    Build
                </button>
                <a href="/" class="button ghost">Back</a>
            </div>

        </form>

    </div>
</main>
